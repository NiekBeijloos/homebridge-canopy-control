{
  "name": "homebridge-canopy-control",
  "displayName": "Canopy Control",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Homebridge plugin to control a Teleco canopy remote",
  "author": "Niek Beijloos",
  "license": "Apache-2.0",
  "homepage": "https://github.com/NiekBeijloos/homebridge-canopy-control/blob/latest/README.md",
  "repository": {
    "type": "git",
    "url": "hhttps://github.com/NiekBeijloos/homebridge-canopy-control.git"
  },
  "bugs": {
    "url": "https://github.com/NiekBeijloos/homebridge-canopy-control/issues"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^18.20.4 || ^20.18.0 || ^22.10.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "prepare:python_env": "node src/infrastructure/create_python_venv.js requirements.txt",
    "prepare:generate_tls_certificate": "cross-var node src/infrastructure/run_python.js src/infrastructure/generate_certificate.py --output_path %CER_OUTPUT_PATH% --ip auto --expiration_days 3600",
    "prepare": "cross-env CER_OUTPUT_PATH=dist/certificates/generated npm-run-all --serial prepare:python_env prepare:generate_tls_certificate",
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "homebridge-lib": "^7.1.4",
    "onoff": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "homebridge": "^2.0.0-beta.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1",
    "npm-run-all": "^4.1.5",
    "cross-env": "^7.0.3",
    "cross-var": "^1.1.0"
  }
}
