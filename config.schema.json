{
  "pluginAlias": "CanopyControl",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "required": ["application", "serialnumber", "manufacturer", "model"],
    "properties": {
      "application": {
        "title": "application",
        "type": "string",
        "default": "Canopy Control"
      },
      "serialnumber": {
        "title": "serial number",
        "type": "string",
        "default": "123"
      },
      "manufacturer": {
        "title": "manufacturer",
        "type": "string",
        "default": "Teleco"
      },
      "model": {
        "title": "model",
        "type": "string",
        "default": "TVEVO868N42x"
      },
      "triggerswitches": {
        "title": "Trigger Switches",
        "description": "A Trigger Switch temporarly turns ON when tapped and then 'bounces' back to the OFF state",
        "type": "array",
        "items": { "$ref": "#/$defs/items" },
        "default": []
      },
      "switches": {
        "title": "Switches",
        "description": "A Switch remains in the given state (ON/OFF) once tapped",
        "type": "array",
        "items": { "$ref": "#/$defs/items" },
        "default": []
      }
    },
    "$defs":{
      "items": {
        "type": "object",
        "required": ["name", "gpio"],
        "properties": {
          "name": {
            "title": "button name",
            "type": "string"
          },
          "gpio":{
            "title": "gpio",
            "type": "number",
            "description": "The pin connected to the respective remote button",
            "minimum": 0,
            "maximum": 27
          }
        }
      }
    }
  }
}
